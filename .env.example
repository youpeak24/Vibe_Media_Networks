# Server Configuration
PORT=5000

# Email Delivery Configuration (Nodemailer)
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Email where inquiries/applications will be delivered
RECIPIENT_EMAIL=your-recipient-email@domain.com

# AI chat assistant (server-only, used by api/chat.js)
# Get a key at https://console.groq.com/keys. Never prefix it with VITE_.
GROQ_API_KEY=
# Optional: override the primary model (default openai/gpt-oss-120b, with automatic fallbacks).
GROQ_MODEL=
